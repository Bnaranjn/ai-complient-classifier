generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Complaint {
  id              Int      @id @default(autoincrement())
  text            String
  category        String?
  sentiment       String?
  severity        String?
  summary         String?
  suggestedAction String?
  priorityScore   Int?
  priorityReason  String?
  createdAt       DateTime @default(now())
}